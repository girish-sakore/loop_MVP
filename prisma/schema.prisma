generator client {
  provider = "prisma-client-js"
}


datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  name          String?
  emailVerified Boolean        @default(false)
  image         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  
  // Subscription
  isPremium         Boolean       @default(false)
  plan              String?       // "monthly" | "yearly"
  subscriptionStart DateTime?
  subscriptionEnd   DateTime?

  sessions      Session[]
  accounts      Account[]
  subscriptions Subscription[]
  editionProgress UserEditionProgress[]
  nodeProgress    UserNodeProgress[]
  streak UserStreak?
  streakDays UserStreakDay[]

  @@map("user")
}

model UserStreak {
  userId            String    @id
  currentStreak     Int       @default(0)
  longestStreak     Int       @default(0)
  lastCompletedDate DateTime? @db.Date
  updatedAt         DateTime  @updatedAt
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_streak")
}

// One row for every IST day on which the user completed at least one game.
// This is the source of truth for the calendar; UserStreak is its summary.
model UserStreakDay {
  userId String
  date   DateTime @db.Date
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, date])
  @@map("user_streak_day")
}

model Subscription {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  razorpayOrderId   String   @unique
  razorpayPaymentId String?
  status            String   // "created" | "paid" | "failed"
  plan              String   // "monthly" | "yearly"
  amountPaise       Int
  currency          String   @default("INR")
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("subscription")
}

// Session, Account, Verification
model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

model UserEditionProgress {
  id            String    @id @default(cuid())
  userId        String
  editionId     String    // matches Edition.id from JSON e.g. "edition-001"
  
  status        String    @default("not_started")
  // "not_started" | "in_progress" | "completed"
  
  currentNodeIndex Int       @default(0) @map("current_stage")
  score         Int       @default(0)
  correctAnswers Int      @default(0)
  totalAnswers  Int       @default(0)
  
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, editionId])  // one record per user per edition
  @@map("user_edition_progress")
}

model UserNodeProgress {
  id              String    @id @default(cuid())
  userId          String
  editionId       String
  nodeId          String                        // e.g. "node-1", matches EditionNode.id

  status          String    @default("not_started") // not_started | in_progress | completed
  currentSubStage Int       @default(0)
  attemptsRemaining Int?    // null for legacy/uninitialized progress; zero means exhausted
  stagePassed     Boolean   @default(false)
  score           Int       @default(0)
  correctAnswers  Int       @default(0)
  totalAnswers    Int       @default(0)
  stars           Int       @default(0)             // 0-3, computed server-side on completion
  hintsRemaining  Int       @default(3)
 
  clientUpdatedAt BigInt    @default(0)
  version         Int       @default(1)
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, editionId, nodeId])
  @@map("user_node_progress")
}

enum EditionStatus {
  DRAFT
  SCHEDULED
  ARCHIVED
}

model ImportBatch {
  id         String   @id @default(cuid())
  fileName   String
  totalCount Int
  importedBy String?  // userId or email, nullable until roles exist
  createdAt  DateTime @default(now())
  games      Game[]

  @@map("import_batch")
}

model Game {
  id            String       @id @default(cuid())
  type          String       // StageType, validated by Zod, not by the DB
  title         String
  subtitle      String?
  isPremium     Boolean      @default(false)
  subStages     Json         // array of stages, shape depends on `type`
  schemaVersion Int          @default(1)

  importBatchId String?
  importBatch   ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)

  editionId     String?      // null = unassigned library
  edition       Edition?     @relation(fields: [editionId], references: [id], onDelete: SetNull)
  position      Int?

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  // One card per type per edition. Postgres treats NULLs as distinct,
  // so unassigned library games can still share a type.
  @@unique([editionId, type])
  @@index([editionId, position])
  @@index([type])
  @@map("game")
}

model Edition {
  id            String        @id @default(cuid())
  title         String
  description   String
  theme         String
  category      String?
  author        String?
  coverImage    String?
  estimatedTime String?
  status        EditionStatus @default(DRAFT)
  date          DateTime?     @unique @db.Date // the IST calendar day it goes live
  snapshot      Json?
  games         Game[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status, date])
  @@map("edition")
}
